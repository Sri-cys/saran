<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>PSG iTech Library System</display-name>
    <description>College Library Resource and Queue Management System</description>

    <!-- Application Lifecycle Listener -->
    <listener>
        <listener-class>com.psgitech.library.listener.AppContextListener</listener-class>
    </listener>

    <!-- 1. Correlation ID Filter -->
    <filter>
        <filter-name>RequestIdFilter</filter-name>
        <filter-class>com.psgitech.library.filter.RequestIdFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RequestIdFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- 2. Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.psgitech.library.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- 3. Authorization Filter (RBAC) -->
    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>com.psgitech.library.filter.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- 3a. Librarian Portal Auth Filter -->
    <filter>
        <filter-name>LibrarianAuthFilter</filter-name>
        <filter-class>com.psgitech.library.filter.LibrarianAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LibrarianAuthFilter</filter-name>
        <url-pattern>/librarian-dashboard.html</url-pattern>
        <url-pattern>/api/librarian/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- 4. CSRF Protection Filter (Synchronizer Token Pattern, Decision D1) -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.psgitech.library.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- 5. Concurrency & Admission Control Filter -->
    <filter>
        <filter-name>ConcurrencyFilter</filter-name>
        <filter-class>com.psgitech.library.filter.ConcurrencyFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ConcurrencyFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Tomcat JNDI DataSource Resource Reference -->
    <resource-ref>
        <description>PSG iTech Library MySQL Connection Pool</description>
        <res-ref-name>jdbc/PsgItechDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

</web-app>
